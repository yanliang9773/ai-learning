# 复制这个文件为 .env，然后填入真实密钥
# .env 已被 .gitignore 屏蔽，永远不会被提交
#
# 三种常见写法，用哪一种取决于你第 7 周选的服务商：

# ① OpenAI 或任何 OpenAI 兼容端点（国内多数聚合服务都是这个格式）
OPENAI_API_KEY=sk-这里替换成你的密钥
OPENAI_BASE_URL=https://api.openai.com/v1
# 如果用的是国内兼容服务，改成它的地址，例如：
# OPENAI_BASE_URL=https://你的服务商域名/v1

# ② Anthropic（Claude）
# ANTHROPIC_API_KEY=sk-ant-替换成你的密钥

# ③ 模型名字，第 7 周脚本会读它
MODEL_NAME=gpt-4o-mini
